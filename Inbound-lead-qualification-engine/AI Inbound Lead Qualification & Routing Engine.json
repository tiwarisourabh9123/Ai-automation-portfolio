    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const body = item.json.body || {};\n  \n  const firstName = (body.first_name || '').trim();\n  const lastName = (body.last_name || '').trim();\n  const email = (body.email || '').trim().toLowerCase();\n  const company = (body.company || '').trim();\n  const useCase = (body.use_case_notes || '').trim();\n  \n  const companySize = parseInt(body.company_size, 10) || 0;\n  const rawBudget = (body.annual_budget || '').replace(/[^0-9]/g, '');\n  const annualBudget = parseInt(rawBudget, 10) || 0;\n  \n  let score = 20;\n  \n  if (companySize >= 100) score += 30;\n  else if (companySize >= 25) score += 20;\n  else if (companySize >= 5) score += 10;\n  \n  if (annualBudget >= 20000) score += 35;\n  else if (annualBudget >= 10000) score += 25;\n  else if (annualBudget >= 3000) score += 15;\n  \n  const isCorporateEmail = !email.endsWith('@gmail.com') && \n                           !email.endsWith('@yahoo.com') && \n                           !email.endsWith('@hotmail.com') &&\n                           !email.endsWith('@outlook.com');\n  if (isCorporateEmail) score += 15;\n  \n  const finalScore = Math.min(score, 100);\n  const qualificationTier = finalScore >= 70 ? 'Tier 1 (High Priority)' \n                          : finalScore >= 45 ? 'Tier 2 (Medium Priority)' \n                          : 'Tier 3 (Nurture)';\n\n  return {\n    json: {\n      fullName: `${firstName} ${lastName}`.trim(),\n      email,\n      company,\n      companySize,\n      annualBudget,\n      isCorporateEmail,\n      initialScore: finalScore,\n      qualificationTier,\n      useCaseNotes: useCase,\n      receivedAt: new Date().toISOString()\n    }\n  };\n});"
      },
